# ASFI service configuration

# MySQL connection for asfi_central
ASFI_DB_USER=root
ASFI_DB_PASSWORD=root123
ASFI_DB_HOST=localhost
ASFI_DB_PORT=3306
ASFI_DB_NAME=asfi_central

# BCB simulator endpoint
BCB_URL=http://127.0.0.1:8001/rate

# Bank API tokens (matching the bank API envs)
TOKEN_BANCO_UNION=token_banco_union
TOKEN_BCP=token_bcp
TOKEN_FORTALEZA=token_fortaleza
TOKEN_MERCANTIL=token_mercantil
TOKEN_BISA=token_bisa
TOKEN_SOLIDARIO=token_solidario
TOKEN_DESARROLLO_PRODUCTIVO=token_desarrollo_productivo
TOKEN_BNB=token_bnb
TOKEN_ECONOMICO=token_economico
TOKEN_FIE=token_fie
TOKEN_GANADERO=token_ganadero
TOKEN_PRODEM=token_prodem
TOKEN_PYME_COMUNIDAD=token_pyme_comunidad
TOKEN_ARGENTINA=token_argentina

# Optional decrypt keys for asymmetric algorithms (if available)
RSA_PRIVATE_KEY=""  # PEM
ECC_PRIVATE_KEY=""  # PEM
ELGAMAL_PRIVATE_KEY=""  # (not used by default)
